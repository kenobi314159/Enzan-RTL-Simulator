# SPDX-License-Identifier: GPL-3.0-or-later
#
# cocotb's simulator makefile for Enzan.
#
# cocotb includes this as simulators/Makefile.enzan when SIM=enzan, after its own Makefile.inc,
# so everything cocotb's makefiles define is available here. `makefiles.sh` beside this file
# writes a copy of cocotb's makefile directory with this added, since cocotb chooses a simulator
# by the files in its own directory and has no way to add one from outside:
#
#   tools/cocotb/makefiles.sh build/cocotb-makefiles
#   make SIM=enzan COCOTB_MAKEFILES_DIR=$PWD/build/cocotb-makefiles
#
# ENZAN_BIN_DIR names the directory holding `enzan` when it is not on the PATH.
#
# This makefile is for cocotb 2.1, which tests/conformance/cocotb/requirements.txt pins. Later
# cocotb versions may carry a Makefile.enzan of their own, which loads cocotb as those releases
# do, through its bootstrap library and GPI_IMPL, where this one uses --lib-name-path and
# GPI_EXTRA, which they removed. With one of them `make SIM=enzan` needs no copy, and makefiles.sh
# keeps cocotb's own.

TOPLEVEL_LANG ?= verilog

ifeq ($(filter verilog vhdl,$(TOPLEVEL_LANG)),)
    $(error A valid value (verilog or vhdl) was not provided for TOPLEVEL_LANG=$(TOPLEVEL_LANG))
endif

ifdef ENZAN_BIN_DIR
    CMD := $(call find_command,$(ENZAN_BIN_DIR)/enzan)
else
    CMD := $(call find_command,enzan)
endif

# cocotb's VPI layer compiled with no simulator-specific workaround in it, so that Enzan is held to
# what cocotb expects of a standard simulator; and its VHPI layer as built for NVC, whose one
# workaround is to compare names without their case, which Enzan does not keep for VHDL any more
# than NVC does.
ENZAN_VPI_LIBRARY := $(shell $(PYTHON_BIN) -m cocotb_tools.config --lib-name-path vpi dsim)
ENZAN_VHPI_LIBRARY := $(shell $(PYTHON_BIN) -m cocotb_tools.config --lib-name-path vhpi nvc)

# The toplevel's language's layer is loaded, and in a design of both languages cocotb loads the
# other's, which GPI_EXTRA names with its entry point, as it does for every simulator of both.
GPI_EXTRA :=
ifeq ($(TOPLEVEL_LANG),verilog)
    ENZAN_PLI := --vpi $(ENZAN_VPI_LIBRARY)
ifneq ($(strip $(VHDL_SOURCES)),)
    GPI_EXTRA := $(ENZAN_VHPI_LIBRARY):cocotbvhpi_entry_point
endif
else
    ENZAN_PLI := --vhpi $(ENZAN_VHPI_LIBRARY)
ifneq ($(strip $(VERILOG_SOURCES)),)
    GPI_EXTRA := $(ENZAN_VPI_LIBRARY):cocotbvpi_entry_point
endif
endif

# VHDL is analysed into the library cocotb names, `work` unless TOPLEVEL_LIBRARY says otherwise.
# RTL_LIBRARY, its old name, is still read, with the warning cocotb's own makefiles give for it.
ifdef RTL_LIBRARY
    $(warning Using RTL_LIBRARY is deprecated, please use TOPLEVEL_LIBRARY instead.)
    TOPLEVEL_LIBRARY ?= $(RTL_LIBRARY)
else
    TOPLEVEL_LIBRARY ?= work
endif
ifeq ($(TOPLEVEL_LANG),vhdl)
    ENZAN_WORK := --work $(TOPLEVEL_LIBRARY)
endif

# Libraries are opt-in, as they are on Enzan's command line. ENZAN_INPUT_LIBRARIES names existing
# libraries in search order, each as a path or name=path. VHDL_LIB_ORDER asks this makefile to build
# cocotb's named VHDL libraries under ENZAN_LIBRARY_ROOT. ENZAN_OUT_LIB asks it to analyse the main
# sources into that library before the run; without it the main sources stay in the one-shot flow.
ENZAN_LIBRARY_ROOT ?= $(SIM_BUILD)/enzan-libraries
ENZAN_INPUT_LIBRARIES ?=
ENZAN_CONTEXT_SOURCES ?=
ENZAN_OUT_LIB ?=

ENZAN_INPUT_LIBRARY_ARGS = $(foreach LIB,$(ENZAN_INPUT_LIBRARIES),--in-lib $(LIB))
ENZAN_VHDL_LIBRARY_ARGS = $(foreach LIB,$(VHDL_LIB_ORDER),--in-lib $(ENZAN_LIBRARY_ROOT)/$(LIB))
ENZAN_OUTPUT_LIBRARY_ARG = $(if $(strip $(ENZAN_OUT_LIB)),--in-lib $(ENZAN_OUT_LIB))
ENZAN_CONTEXT_ARGS = $(foreach SOURCE,$(ENZAN_CONTEXT_SOURCES),--context $(SOURCE))

# Stamps and dependency files make each VHDL library an independent incremental target. A library
# depends on every one before it because VHDL_LIB_ORDER is both its analysis and search order.
ENZAN_VHDL_LIBRARY_STAMPS :=
ENZAN_PREVIOUS_VHDL_LIBRARY_ARGS := $(ENZAN_INPUT_LIBRARY_ARGS)
ENZAN_PREVIOUS_VHDL_LIBRARY_STAMPS :=

define enzan_vhdl_library
$(ENZAN_LIBRARY_ROOT)/$(1)/.stamp: $$(VHDL_SOURCES_$(1)) $$(CUSTOM_COMPILE_DEPS) $(ENZAN_PREVIOUS_VHDL_LIBRARY_STAMPS) | $(SIM_BUILD) enzan-check-vhdl-libraries
	@if test ! -f $(ENZAN_LIBRARY_ROOT)/$(1)/enzan.lib; then \
		$$(CMD) lib create --name $(1) $(ENZAN_LIBRARY_ROOT)/$(1) >/dev/null; \
	fi
	$$(CMD) analyse --out-lib $(ENZAN_LIBRARY_ROOT)/$(1) \
		$(ENZAN_PREVIOUS_VHDL_LIBRARY_ARGS) $$(COMPILE_ARGS) \
		--depfile $(ENZAN_LIBRARY_ROOT)/$(1)/deps.d --depfile-target $$@ \
		$$(VHDL_SOURCES_$(1))
	@touch $$@

ENZAN_VHDL_LIBRARY_STAMPS += $(ENZAN_LIBRARY_ROOT)/$(1)/.stamp
ENZAN_PREVIOUS_VHDL_LIBRARY_STAMPS += $(ENZAN_LIBRARY_ROOT)/$(1)/.stamp
ENZAN_PREVIOUS_VHDL_LIBRARY_ARGS += --in-lib $(ENZAN_LIBRARY_ROOT)/$(1)
endef

$(foreach LIB,$(VHDL_LIB_ORDER),$(eval $(call enzan_vhdl_library,$(LIB))))

# Dependency files appear only after the first analysis. The next make reads them and learns every
# source, included header and context file that Enzan read.
-include $(wildcard $(ENZAN_LIBRARY_ROOT)/*/deps.d)
ifneq ($(strip $(ENZAN_OUT_LIB)),)
-include $(wildcard $(ENZAN_OUT_LIB)/deps.d)
else
-include $(wildcard $(SIM_BUILD)/enzan.d)
endif

TOPLEVELS := $(call deprecate,TOPLEVEL,COCOTB_TOPLEVEL)
ifneq ($(words $(TOPLEVELS)),0)
ifneq ($(words $(TOPLEVELS)),1)
    $(error cocotb's toplevel is one, and COCOTB_TOPLEVEL names $(words $(TOPLEVELS)): $(TOPLEVELS); give another top level beside it with EXTRA_ARGS += --top <name>)
endif
    TOPMODULE_ARG := --top $(TOPLEVELS)
endif

# Enzan counts every delay in one unit, so the precision is the unit, and it has to be one
# `--timescale` names: 1ns rather than 10ns.
ENZAN_TIMESCALE := $(patsubst 1%,%,$(strip $(COCOTB_HDL_TIMEPRECISION)))
ifeq ($(filter s ms us ns ps fs,$(ENZAN_TIMESCALE)),)
    $(error Enzan cannot count time in COCOTB_HDL_TIMEPRECISION=$(COCOTB_HDL_TIMEPRECISION); it takes 1s, 1ms, 1us, 1ns, 1ps or 1fs)
endif

ifdef VERILOG_INCLUDE_DIRS
    COMPILE_ARGS += $(addprefix -I ,$(VERILOG_INCLUDE_DIRS))
endif

# Storing both languages in one library is not supported yet. Their ordinary one-shot flow, and a
# mixed design that reads separately analysed libraries, remain supported when ENZAN_OUT_LIB is
# unset.
ENZAN_VERILOG_INPUTS := $(strip $(VERILOG_SOURCES) $(ENZAN_CONTEXT_SOURCES))
ENZAN_VHDL_INPUTS := $(strip $(VHDL_SOURCES) $(VHDL_LIB_ORDER))
ifneq ($(strip $(ENZAN_OUT_LIB)),)
ifneq ($(ENZAN_VERILOG_INPUTS),)
ifneq ($(ENZAN_VHDL_INPUTS),)
    $(error ENZAN_OUT_LIB cannot store a mixed-language design yet; leave it unset to use Enzan's one-shot mixed-language flow)
endif
endif
ifeq ($(strip $(VERILOG_SOURCES) $(VHDL_SOURCES)),)
    $(error ENZAN_OUT_LIB was given, but there are no VERILOG_SOURCES or VHDL_SOURCES to analyse into it)
endif
ifneq ($(filter $(TOPLEVEL_LIBRARY),$(VHDL_LIB_ORDER)),)
    $(error TOPLEVEL_LIBRARY=$(TOPLEVEL_LIBRARY) is also in VHDL_LIB_ORDER; the main and auxiliary libraries need distinct logical names)
endif
endif

# Its own variable rather than SIM_ARGS, which a make command line giving SIM_ARGS replaces.
ifeq ($(WAVES),1)
    ENZAN_WAVES := --fst $(SIM_BUILD)/$(TOPLEVELS).fst
endif

# GUI=1 hands the design to Enzan's window, which runs it when asked, or at once with `--run all`
# in SIM_ARGS. Closing the window ends the simulation with the simulation's exit status, so
# the results are checked as after a batch run.
ifeq ($(GUI),1)
    ENZAN_GUI := --gui
endif

# cocotb's own consistency checks run before any VHDL library is analysed. An order-only
# prerequisite keeps the checks from making an otherwise current stamp rebuild on every make.
.PHONY: enzan-check-vhdl-libraries
enzan-check-vhdl-libraries:
	$(foreach LIB, $(VHDL_LIB_ORDER), $(check_vhdl_sources))
	$(foreach SOURCES_VAR, $(filter VHDL_SOURCES_%, $(.VARIABLES)), $(check_lib_order))

# ENZAN_OUT_LIB is the explicit switch from the one-shot flow to separate analysis and execution.
# Its logical name is TOPLEVEL_LIBRARY, independent of where its directory is placed.
ENZAN_ANALYSIS_STAMPS := $(ENZAN_VHDL_LIBRARY_STAMPS)
ifneq ($(strip $(ENZAN_OUT_LIB)),)
ENZAN_MAIN_LIBRARY_STAMP := $(ENZAN_OUT_LIB)/.stamp
ENZAN_ANALYSIS_STAMPS += $(ENZAN_MAIN_LIBRARY_STAMP)

$(ENZAN_MAIN_LIBRARY_STAMP): $(VERILOG_SOURCES) $(VHDL_SOURCES) $(ENZAN_CONTEXT_SOURCES) \
                              $(CUSTOM_COMPILE_DEPS) $(ENZAN_VHDL_LIBRARY_STAMPS) \
                              | $(SIM_BUILD) enzan-check-vhdl-libraries
	@if test ! -f $(ENZAN_OUT_LIB)/enzan.lib; then \
		$(CMD) lib create --name $(TOPLEVEL_LIBRARY) $(ENZAN_OUT_LIB) >/dev/null; \
	fi
	$(CMD) analyse $(TOPMODULE_ARG) --timescale $(ENZAN_TIMESCALE) \
		--out-lib $(ENZAN_OUT_LIB) $(ENZAN_WORK) \
		$(ENZAN_INPUT_LIBRARY_ARGS) $(ENZAN_VHDL_LIBRARY_ARGS) \
		$(ENZAN_CONTEXT_ARGS) $(COMPILE_ARGS) $(EXTRA_ARGS) \
		--depfile $(ENZAN_OUT_LIB)/deps.d --depfile-target $@ \
		$(VERILOG_SOURCES) $(VHDL_SOURCES)
	@touch $@
endif

.PHONY: analyse
analyse: enzan-check-vhdl-libraries $(ENZAN_ANALYSIS_STAMPS)

# With a stored main library, or with no direct sources, an explicit `run` reads libraries only.
# Otherwise the shorthand command analyses the direct sources and runs them in one process. Its
# dependency file attaches included headers to the results target for incremental `regression`.
ifneq ($(strip $(ENZAN_OUT_LIB)),)
ENZAN_SUBCOMMAND := run
ENZAN_RUN_ANALYSIS_ARGS :=
ENZAN_RUN_SOURCES :=
else ifeq ($(strip $(VERILOG_SOURCES) $(VHDL_SOURCES)),)
ENZAN_SUBCOMMAND := run
ENZAN_RUN_ANALYSIS_ARGS :=
ENZAN_RUN_SOURCES :=
else
ENZAN_SUBCOMMAND :=
ENZAN_RUN_ANALYSIS_ARGS = $(ENZAN_CONTEXT_ARGS) $(COMPILE_ARGS) \
                          --depfile $(SIM_BUILD)/enzan.d \
                          --depfile-target $(COCOTB_RESULTS_FILE)
ENZAN_RUN_SOURCES = $(VERILOG_SOURCES) $(VHDL_SOURCES)
endif

ENZAN_ARGS = $(ENZAN_SUBCOMMAND) $(TOPMODULE_ARG) --timescale $(ENZAN_TIMESCALE) \
             $(ENZAN_PLI) $(ENZAN_WORK) $(ENZAN_INPUT_LIBRARY_ARGS) \
             $(ENZAN_VHDL_LIBRARY_ARGS) $(ENZAN_OUTPUT_LIBRARY_ARG) $(ENZAN_WAVES) \
             $(ENZAN_GUI) $(ENZAN_RUN_ANALYSIS_ARGS) $(SIM_ARGS) $(EXTRA_ARGS) \
             $(ENZAN_RUN_SOURCES) $(call deprecate,PLUSARGS,COCOTB_PLUSARGS)

ENZAN_RESULTS_DEPS := $(ENZAN_ANALYSIS_STAMPS) $(CUSTOM_SIM_DEPS)
ifeq ($(strip $(ENZAN_OUT_LIB)),)
ENZAN_RESULTS_DEPS += $(VERILOG_SOURCES) $(VHDL_SOURCES) $(ENZAN_CONTEXT_SOURCES) \
                      $(CUSTOM_COMPILE_DEPS)
endif

$(COCOTB_RESULTS_FILE): $(ENZAN_RESULTS_DEPS) | $(SIM_BUILD) enzan-check-vhdl-libraries
	$(RM) $(COCOTB_RESULTS_FILE)

	GPI_EXTRA=$(GPI_EXTRA) $(COCOTB_ENV) $(SIM_CMD_PREFIX) $(CMD) $(ENZAN_ARGS) $(SIM_CMD_SUFFIX)

	$(call check_results)

.PHONY: debug
debug: $(ENZAN_RESULTS_DEPS) | $(SIM_BUILD) enzan-check-vhdl-libraries
	$(RM) $(COCOTB_RESULTS_FILE)

	GPI_EXTRA=$(GPI_EXTRA) $(COCOTB_ENV) $(SIM_CMD_PREFIX) gdb --args $(CMD) $(ENZAN_ARGS) $(SIM_CMD_SUFFIX)

	$(call check_results)
