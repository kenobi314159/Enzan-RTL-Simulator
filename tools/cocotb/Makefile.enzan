# SPDX-License-Identifier: GPL-3.0-or-later
#
# cocotb's simulator makefile for Enzan.
#
# cocotb includes this as simulators/Makefile.enzan when SIM=enzan, after its own Makefile.inc,
# so everything cocotb's makefiles define is available here. `makefiles.sh` beside this file
# writes a copy of cocotb's makefile directory with this added, since cocotb chooses a simulator
# by the files in its own directory and has no way to add one from outside:
#
#   tools/cocotb/makefiles.sh build/cocotb-makefiles
#   make SIM=enzan COCOTB_MAKEFILES_DIR=$PWD/build/cocotb-makefiles
#
# ENZAN_BIN_DIR names the directory holding `enzan` when it is not on the PATH.

TOPLEVEL_LANG ?= verilog

ifeq ($(filter verilog vhdl,$(TOPLEVEL_LANG)),)
    $(error A valid value (verilog or vhdl) was not provided for TOPLEVEL_LANG=$(TOPLEVEL_LANG))
endif

ifdef ENZAN_BIN_DIR
    CMD := $(call find_command,$(ENZAN_BIN_DIR)/enzan)
else
    CMD := $(call find_command,enzan)
endif

# cocotb's VPI layer compiled with no simulator-specific workaround in it, so that Enzan is held to
# what cocotb expects of a standard simulator; and its VHPI layer as built for NVC, whose one
# workaround is to compare names without their case, which Enzan does not keep for VHDL any more
# than NVC does.
ENZAN_VPI_LIBRARY := $(shell $(PYTHON_BIN) -m cocotb_tools.config --lib-name-path vpi dsim)
ENZAN_VHPI_LIBRARY := $(shell $(PYTHON_BIN) -m cocotb_tools.config --lib-name-path vhpi nvc)

# The toplevel's language's layer is loaded, and in a design of both languages cocotb loads the
# other's, which GPI_EXTRA names with its entry point, as it does for every simulator of both.
GPI_EXTRA :=
ifeq ($(TOPLEVEL_LANG),verilog)
    ENZAN_PLI := --vpi $(ENZAN_VPI_LIBRARY)
ifneq ($(strip $(VHDL_SOURCES)),)
    GPI_EXTRA := $(ENZAN_VHPI_LIBRARY):cocotbvhpi_entry_point
endif
else
    ENZAN_PLI := --vhpi $(ENZAN_VHPI_LIBRARY)
ifneq ($(strip $(VERILOG_SOURCES)),)
    GPI_EXTRA := $(ENZAN_VPI_LIBRARY):cocotbvpi_entry_point
endif
endif

# VHDL is analysed into the library cocotb names, `work` unless TOPLEVEL_LIBRARY says otherwise.
# RTL_LIBRARY, its old name, is still read, with the warning cocotb's own makefiles give for it.
ifdef RTL_LIBRARY
    $(warning Using RTL_LIBRARY is deprecated, please use TOPLEVEL_LIBRARY instead.)
    TOPLEVEL_LIBRARY ?= $(RTL_LIBRARY)
else
    TOPLEVEL_LIBRARY ?= work
endif
ifneq ($(strip $(VHDL_SOURCES)),)
    ENZAN_WORK := --work $(TOPLEVEL_LIBRARY)
endif

# Each library VHDL_LIB_ORDER names is analysed from its VHDL_SOURCES_<library> into an Enzan
# library of its own, in that order and against those before it, and the run reads them all.
ENZAN_LIBRARIES := $(SIM_BUILD)/enzan-libraries
ENZAN_IN_LIBS := $(foreach LIB,$(VHDL_LIB_ORDER),--in-lib $(ENZAN_LIBRARIES)/$(LIB))

TOPLEVELS := $(call deprecate,TOPLEVEL,COCOTB_TOPLEVEL)
ifneq ($(words $(TOPLEVELS)),0)
ifneq ($(words $(TOPLEVELS)),1)
    $(error cocotb's toplevel is one, and COCOTB_TOPLEVEL names $(words $(TOPLEVELS)): $(TOPLEVELS); give another top level beside it with EXTRA_ARGS += --top <name>)
endif
    TOPMODULE_ARG := --top $(TOPLEVELS)
endif

# Enzan counts every delay in one unit, so the precision is the unit, and it has to be one
# `--timescale` names: 1ns rather than 10ns.
ENZAN_TIMESCALE := $(patsubst 1%,%,$(strip $(COCOTB_HDL_TIMEPRECISION)))
ifeq ($(filter s ms us ns ps fs,$(ENZAN_TIMESCALE)),)
    $(error Enzan cannot count time in COCOTB_HDL_TIMEPRECISION=$(COCOTB_HDL_TIMEPRECISION); it takes 1s, 1ms, 1us, 1ns, 1ps or 1fs)
endif

ifdef VERILOG_INCLUDE_DIRS
    COMPILE_ARGS += $(addprefix -I ,$(VERILOG_INCLUDE_DIRS))
endif

ifeq ($(WAVES),1)
    SIM_ARGS += --fst $(SIM_BUILD)/$(TOPLEVELS).fst
endif

ENZAN_ARGS = $(TOPMODULE_ARG) --timescale $(ENZAN_TIMESCALE) $(ENZAN_PLI) $(ENZAN_WORK) \
             $(ENZAN_IN_LIBS) $(COMPILE_ARGS) $(SIM_ARGS) $(EXTRA_ARGS) $(VERILOG_SOURCES) \
             $(VHDL_SOURCES) $(call deprecate,PLUSARGS,COCOTB_PLUSARGS)

# The libraries VHDL_LIB_ORDER names, analysed afresh, each against those analysed before it.
ifneq ($(strip $(VHDL_LIB_ORDER)),)
define enzan_analyse_libraries
	$(RM) -r $(ENZAN_LIBRARIES)
	set -e; against=""; $(foreach LIB,$(VHDL_LIB_ORDER),$(CMD) lib create --name $(LIB) $(ENZAN_LIBRARIES)/$(LIB) >/dev/null; $(CMD) analyse --out-lib $(ENZAN_LIBRARIES)/$(LIB) $$against $(COMPILE_ARGS) $(VHDL_SOURCES_$(LIB)); against="$$against --in-lib $(ENZAN_LIBRARIES)/$(LIB)";) true
endef
endif

# Analysis, elaboration and the run are one process, so there is no compiled image to keep and
# the results file is the only target.
$(COCOTB_RESULTS_FILE): $(VERILOG_SOURCES) $(VHDL_SOURCES) $(CUSTOM_COMPILE_DEPS) $(CUSTOM_SIM_DEPS) | $(SIM_BUILD)
	$(RM) $(COCOTB_RESULTS_FILE)
	$(enzan_analyse_libraries)

	GPI_EXTRA=$(GPI_EXTRA) $(COCOTB_ENV) $(SIM_CMD_PREFIX) $(CMD) $(ENZAN_ARGS) $(SIM_CMD_SUFFIX)

	$(call check_results)

debug: $(VERILOG_SOURCES) $(VHDL_SOURCES) $(CUSTOM_COMPILE_DEPS) $(CUSTOM_SIM_DEPS) | $(SIM_BUILD)
	$(RM) $(COCOTB_RESULTS_FILE)
	$(enzan_analyse_libraries)

	GPI_EXTRA=$(GPI_EXTRA) $(COCOTB_ENV) $(SIM_CMD_PREFIX) gdb --args $(CMD) $(ENZAN_ARGS) $(SIM_CMD_SUFFIX)

	$(call check_results)
