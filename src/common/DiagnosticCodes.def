// SPDX-License-Identifier: GPL-3.0-or-later
//
// The diagnostic catalogue.
//
// This file is included more than once, each time with ENZAN_DIAG defined to do
// something different, so it deliberately has no include guard.
//
//   ENZAN_DIAG(Name, number, DefaultSeverity, "std::format format string")
//
// **Numbers are permanent.** A code appears in user documentation, in
// suppression lists in users' scripts, and in bug reports (DESIGN_GUIDE.md
// section 10.6). Reusing a number for a different meaning silently changes what
// a user's `-Wno-ENZ0007` suppresses. Retire a code by deleting its line and
// never reusing the number; do not renumber the ones after it.
//
// Number ranges, by the component that emits the diagnostic:
//
//   0001-0999  driver, command line, source file handling  (src/common, tools/)
//   1000-1999  SystemVerilog frontend                      (src/frontend/sv)
//   2000-2999  VHDL frontend                               (src/frontend/vhdl)
//   3000-3999  elaboration                                 (src/elab)
//   4000-4999  bytecode generation                         (src/codegen)
//   5000-5999  runtime and scheduler                       (src/runtime)
//   6000-6999  control layer and Tcl commands              (src/control)
//   7000-7999  waveform database                           (src/wavedb)
//   8000-8999  VPI, VHPI and plugin loading                (src/pli)
//   9000-9999  internal errors and unimplemented features  (anywhere)
//
// The format string is consumed by std::format, so arguments are `{}` and a
// literal brace is written `{{`.

// --- 0001-0999: driver, command line and source file handling ---------------

ENZAN_DIAG(CannotOpenFile, 1, Error, "cannot open file '{}': {}")
ENZAN_DIAG(NotARegularFile, 2, Error, "'{}' is not a regular file")
ENZAN_DIAG(FileReadFailed, 3, Error, "could not read '{}': {}")
ENZAN_DIAG(SourceFileTooLarge, 4, Error,
           "'{}' is too large; a single source file must be smaller than {} bytes")
ENZAN_DIAG(TooManyErrors, 5, Fatal,
           "too many errors emitted ({}); no further diagnostics will be reported")
ENZAN_DIAG(BuildWithout, 6, Error, "this build of Enzan was configured with {}, so it cannot {}")

// --- 1000-1999: SystemVerilog frontend --------------------------------------

ENZAN_DIAG(SystemVerilogError, 1001, Error, "{}")
ENZAN_DIAG(SystemVerilogWarning, 1002, Warning, "{}")
ENZAN_DIAG(SystemVerilogNote, 1003, Note, "{}")
ENZAN_DIAG(UnsupportedConstruct, 1004, Error, "{} is not supported yet")
ENZAN_DIAG(NoInputFiles, 1005, Error, "no source files were given")
ENZAN_DIAG(NoTopLevelFound, 1006, Error,
           "the sources contain no module that could serve as a top level")
ENZAN_DIAG(ErrorInDeadCode, 1008, Warning,
           "{}; this code never runs, since a constant condition rules it out")
ENZAN_DIAG(UnusedParameterOverride, 1007, Warning,
           "-G {} names no parameter or generic of a top level, and changes nothing")
ENZAN_DIAG(DelayRounded, 1009, Warning,
           "a delay of {} is no whole number of the run's time unit, and is rounded to {}")
ENZAN_DIAG(RequestedModuleMissing, 1010, Error,
           "VHDL instantiates the module '{}', which no SystemVerilog source declares")
ENZAN_DIAG(RequestedParameterMissing, 1011, Error,
           "module '{}' has no parameter '{}', which a VHDL instance of it sets in its generic "
           "map; add the parameter to the module, or leave the generic out of the map")
ENZAN_DIAG(EncryptedSource, 1012, Error,
           "'{}' holds encrypted code (IEEE 1735), which Enzan cannot decrypt")
ENZAN_DIAG(ParameterInPathCondition, 1013, Warning,
           "{}; a parameter is a constant there, as a specparam is, so the path is accepted")
ENZAN_DIAG(ParallelPathFromOneBit, 1014, Warning,
           "{}; a path from one bit joins it to every bit of the output, so it is accepted as a "
           "full path")

// --- 2000-2999: VHDL frontend -----------------------------------------------

ENZAN_DIAG(VhdlError, 2001, Error, "{}")
ENZAN_DIAG(VhdlWarning, 2002, Warning, "{}")
ENZAN_DIAG(VhdlNote, 2003, Note, "{}")
ENZAN_DIAG(VhdlAnalysisStopped, 2004, Fatal, "VHDL analysis stopped: {}")
ENZAN_DIAG(VhdlUnsupported, 2005, Error, "{} is not supported yet")
ENZAN_DIAG(VhdlProcessNeverWaits, 2006, Error,
           "this process has no sensitivity list and no wait statement, so once started it would "
           "run for ever without letting simulated time advance")
ENZAN_DIAG(VhdlUnboundComponent, 2007, Warning,
           "component '{}' has no entity of its name to be bound to, so this instance is left "
           "unbound and does nothing (IEEE 1076 section 7.3.3); give the entity's source, or bind "
           "the instance with a configuration specification")
ENZAN_DIAG(VhdlVital, 2008, Error,
           "'ieee.{}' is part of VITAL, the library of gate-level timing models (IEEE 1076.4), "
           "which Enzan does not simulate")
ENZAN_DIAG(VhdlLibraryNotGiven, 2009, Error, "library '{}' is not among the libraries given")
ENZAN_DIAG(VhdlDependencyNotGiven, 2010, Error,
           "{} uses '{}', which none of the libraries given holds")

// --- 3000-3999: elaboration -------------------------------------------------

ENZAN_DIAG(TopModuleNotFound, 3001, Error,
           "top module '{}' was not found; the design contains: {}")
ENZAN_DIAG(NoTopModule, 3002, Error,
           "no top module was given and the design has {} candidates: {}; name one with --top")
ENZAN_DIAG(UnresolvedInstance, 3003, Error,
           "instance '{}' refers to module '{}', which none of the sources or libraries given "
           "declares")
ENZAN_DIAG(AmbiguousSpecialisation, 3010, Error,
           "the design holds '{}' with more than one set of parameter values, as {}; name the one "
           "meant, or a top level that instantiates it with the values meant")
ENZAN_DIAG(AmbiguousModule, 3009, Error,
           "'{}' is defined by more than one library ({}); name the one meant, as "
           "<library>.{}")
ENZAN_DIAG(RecursiveInstantiation, 3004, Error,
           "module '{}' instantiates itself, through {}, without end")
ENZAN_DIAG(PortWidthMismatch, 3005, Error,
           "port '{}' of '{}' is {} bits wide but is connected to {} bits")
ENZAN_DIAG(UnconvertiblePort, 3016, Error,
           "port '{}' of '{}' connects SystemVerilog and VHDL, and {}: such a port is not "
           "supported yet")
ENZAN_DIAG(RequestedPortMissing, 3017, Error,
           "module '{}' has no port '{}' for the instance '{}' of another language to connect")
ENZAN_DIAG(RequestedPortDirection, 3018, Error,
           "port '{}' of '{}' is an {}, but the instance '{}' of another language connects it as an "
           "{}")
ENZAN_DIAG(PortEncodingMismatch, 3015, Error,
           "port '{}' of '{}' holds {} but is connected to an object holding {}")
ENZAN_DIAG(MultipleContinuousDrivers, 3006, Error,
           "{} '{}' has {} driven by both {} and {}; a {} takes one continuous driver for each "
           "bit, so drive each bit once, or declare it a `wire`, whose drivers resolve")
ENZAN_DIAG(MixedDriverKinds, 3007, Error,
           "'{}' has {} driven by the continuous assignment {} and also written by {}; a bit "
           "that is driven continuously may not be written procedurally")
ENZAN_DIAG(UnresolvedHierarchicalReference, 3011, Error,
           "the hierarchical reference '{}' in '{}' names nothing in the elaborated design")
ENZAN_DIAG(PackageNamedAsTop, 3012, Error,
           "package '{}' has the name of the top level '{}', and the two cannot be told apart; "
           "rename one of them")
ENZAN_DIAG(UnresolvedSubprogram, 3013, Error,
           "{} calls '{}' of '{}', which no unit of the design declares")
ENZAN_DIAG(SubprogramWritesDrivenSignal, 3014, Error,
           "'{}' has {} written by the subprogram '{}', called from {}, and also driven by {}; a "
           "subprogram writing a signal something else drives is not supported yet, so write it "
           "in the process instead")
ENZAN_DIAG(UnconnectedPort, 3008, Warning,
           "port '{}' of instance '{}' is not connected and will read as X")
ENZAN_DIAG(UnconnectedVhdlPort, 3019, Warning,
           "port '{}' of instance '{}' is not connected and keeps its default value, as a VHDL "
           "port left open does")
ENZAN_DIAG(StrengthsIndistinguishable, 3020, Error,
           "{} of '{}' is driven by {} at {} strength and by {} at {}; drivers of supply against "
           "strong, or of pull against weak, are not supported yet, so give the two the same "
           "strength")

// --- 5000-5999: runtime and scheduler ---------------------------------------

ENZAN_DIAG(DeltaLimitExceeded, 5001, Error,
           "exceeded the delta cycle limit of {} at time {}; the design is not settling. "
           "Still active: {}")
ENZAN_DIAG(CallDepthExceeded, 5011, Error,
           "exceeded the call depth limit of {} calling '{}' from {} at time {}; the design "
           "recurses deeper than the limit, or without end")
ENZAN_DIAG(TimeOverflow, 5002, Error,
           "a delay at time {} would take simulated time past the longest a run counts in units "
           "of {}; a coarser --timescale counts further")
ENZAN_DIAG(UserFatal, 5003, Error, "$fatal: {}")
ENZAN_DIAG(UserError, 5004, Error, "{}")
ENZAN_DIAG(UserWarning, 5005, Warning, "{}")
ENZAN_DIAG(UserInfo, 5006, Note, "{}")
ENZAN_DIAG(AssertionFailure, 5012, Error, "{}")
ENZAN_DIAG(FileNotOpened, 5008, Warning, "$fopen could not open '{}' with mode '{}': {}")
ENZAN_DIAG(FileNotOpen, 5009, Warning, "{} names file descriptor {:#x}, which is not open")
ENZAN_DIAG(ReadMemProblem, 5010, Warning, "{} of '{}': {}")

// --- 6000-6999: the session and its command line -----------------------------

ENZAN_DIAG(FileListUnknownOption, 6005, Error,
           "'{}' is not an option a file list can give Enzan; take it out of the list")
ENZAN_DIAG(FileListMissingValue, 6006, Error, "'{}' needs a value after it")
ENZAN_DIAG(FileListEmptyOption, 6007, Error, "'{}' lists nothing")
ENZAN_DIAG(FileListCycle, 6008, Error, "file list '{}' includes itself: {}")
ENZAN_DIAG(FileListUnterminatedComment, 6009, Error,
           "this block comment is never closed")
ENZAN_DIAG(FileListUnterminatedQuote, 6010, Error,
           "this quoted argument is never closed")
ENZAN_DIAG(FileListUnterminatedBrace, 6011, Error,
           "this ${{...}} substitution is missing its closing brace")
ENZAN_DIAG(EnvironmentVariableNotSet, 6012, Error,
           "the environment variable '{}' is not set; set it, or write the path out in full")
ENZAN_DIAG(NothingAnalysed, 6014, Error,
           "no sources have been analysed, so there is nothing to elaborate")
ENZAN_DIAG(NoSimulation, 6015, Error, "`{}` needs an elaborated design")
ENZAN_DIAG(WaveformScopeAfterOpen, 6017, Error,
           "the recording scope cannot be changed once a waveform file is open")
ENZAN_DIAG(LibraryNotADirectory, 6019, Error,
           "'{}' exists and is not a directory, so it cannot be an analysis library")
ENZAN_DIAG(NotALibrary, 6022, Error,
           "'{}' is not an analysis library; create one with `enzan lib create` before writing "
           "to it or reading from it")
ENZAN_DIAG(LibraryVersionMismatch, 6023, Error,
           "the analysis library '{}' was written with index version {} and this build "
           "understands {}; create it again")
ENZAN_DIAG(LibraryBadName, 6024, Error,
           "'{}' cannot be a library name: a name is a letter or underscore followed by letters, "
           "digits and underscores")
ENZAN_DIAG(LibraryEntryUnreadable, 6025, Error,
           "the analysis library entry '{}' could not be read; the library was written by an "
           "incompatible build or has been damaged, so create it again")
ENZAN_DIAG(LibraryWriteFailed, 6020, Warning,
           "the analysis library entry '{}' could not be written; this run is unaffected and "
           "the next one will analyse from source again")
ENZAN_DIAG(RestartWithVpiApplication, 6026, Error,
           "a design cannot be restarted while a VPI application is loaded, since the application "
           "keeps what it knew of the run; start the run again instead")

// --- 7000-7999: waveform database -------------------------------------------

ENZAN_DIAG(SignalsTooWideToRecord, 7001, Warning,
           "{} records no signal wider than {} bits, and leaves out {}; --wave-max-bits changes "
           "the limit")

// --- 8000-8999: VPI, VHPI and plugin loading --------------------------------

ENZAN_DIAG(LibraryTimeUnitsDiffer, 6027, Error,
           "library '{}' was analysed in units of {} and library '{}' in units of {}; a design "
           "is simulated in one time unit, so its libraries have to be analysed in the same one")
ENZAN_DIAG(WorkLibraryNamedOtherwise, 6029, Error,
           "`--work {}` names another library than the one analysis writes into, which is called "
           "'{}'; leave `--work` out, or create the library with that name (`enzan lib create "
           "--name`)")
ENZAN_DIAG(MixedAnalysisUnsettled, 6030, Error,
           "the design's VHDL and SystemVerilog instantiate each other in turn more than {} times, "
           "the last time for {}; a hierarchy that recurses through both languages is not "
           "supported")
ENZAN_DIAG(VhdlUnitUnrecorded, 6031, Error,
           "'{}' in library '{}' is from an analysis that did not finish; analyse its sources "
           "into the library again")
ENZAN_DIAG(TimingChecksNotRun, 6032, Note,
           "timing checks are not run, so a violation of this one or of any other in the design "
           "is never reported")
ENZAN_DIAG(GenericsWithoutTop, 6033, Error,
           "-G sets generics of the VHDL top level, and an analysis without --top translates no "
           "top level; give -G to the run, or name the top with --top")
ENZAN_DIAG(MixedOverridesWithoutTop, 6034, Error,
           "-G sets the parameters or generics of the top level, and in a design of both "
           "SystemVerilog and VHDL it needs --top to say which unit that is")
ENZAN_DIAG(TimeScaleConflictsWithLibrary, 6028, Error,
           "`--timescale {}` was given, but library '{}' was analysed in units of {}, and its "
           "delays are counts of that unit; leave `--timescale` out to use it, or analyse the "
           "library again in {} (after `enzan lib clean` for a library being written to)")
ENZAN_DIAG(VpiLibraryUnloadable, 8001, Error, "the {} library '{}' could not be loaded: {}")
ENZAN_DIAG(VpiEntryNotFound, 8002, Error,
           "the {} library '{}' has no function called '{}' to start it with")
ENZAN_DIAG(VpiNoStartupRoutines, 8003, Error,
           "the {} library '{}' defines no {}; if it is started some other way, name the "
           "function as --{} <library>:<function>")

// --- 9000-9999: internal errors and unimplemented features -----------------

ENZAN_DIAG(NotYetImplemented, 9001, Error, "{} is not supported yet")
ENZAN_DIAG(InvalidEir, 9003, Error,
           "the design was translated into something invalid, which is a bug in Enzan to report: "
           "{}")
ENZAN_DIAG(InternalError, 9002, Fatal, "internal error, which is a bug in Enzan to report: {}")
