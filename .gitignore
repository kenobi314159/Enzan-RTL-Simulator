# Build directories. CMakePresets.json places all of them under build/.
/build/
/out/
cmake-build-*/

# Compiler and tooling caches.
.cache/
__pycache__/
compile_commands.json
*.gcda
*.gcno
*.profraw
*.profdata

# Simulation libraries and analysis output. Enzan writes these next to wherever
# it is run, and they are regenerated from source.
/work/
*.enzanlib/

# Waveform dumps and transcripts. Never committed.
*.vcd
*.fst
*.fst.hier
/transcript
/transcript.*

# External RTL fetched by tests/designs/ scripts.
/tests/designs/checkout/

# Benchmark results are a per-machine measurement, not a shared artefact: a number taken on one
# laptop is not comparable with one taken on another, and committing them would make the file a
# merge conflict on every run.
/bench/results.tsv

# Editor and OS droppings.
*.swp
*~
.idea/
.vscode/
.DS_Store

# The Python environment CI and contributors install cocotb into (tests/conformance/cocotb).
/.venv/
